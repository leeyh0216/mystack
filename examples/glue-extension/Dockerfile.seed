# syntax=docker/dockerfile:1.7
# Named-volume initialization follows Docker's volume copy-up behavior:
# https://docs.docker.com/engine/storage/volumes/#mounting-a-volume-over-existing-data
ARG PYTHON_BASE=public.ecr.aws/docker/library/python:3.11-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3
FROM ${PYTHON_BASE}

COPY extensions/*.whl /opt/mystack/extensions/

ENTRYPOINT ["python", "-c"]
CMD ["import pathlib; wheels=list(pathlib.Path('/opt/mystack/extensions').glob('*.whl')); assert wheels, 'extension wheel is missing'"]
