{
  "schema_version": 1,
  "github_environment": "ecr-production",
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "components": [
    {
      "name": "proxy",
      "repository": "mystack-proxy",
      "dockerfile": "proxy/Dockerfile"
    },
    {
      "name": "emr",
      "repository": "mystack-emr",
      "dockerfile": "emr/Dockerfile"
    },
    {
      "name": "glue",
      "repository": "mystack-glue",
      "dockerfile": "glue/Dockerfile"
    }
  ],
  "scan": {
    "timeout_seconds": 900,
    "poll_interval_seconds": 10,
    "fail_severities": [
      "CRITICAL"
    ]
  },
  "tags": {
    "release_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
    "manual_prefix": "manual",
    "rollback_prefix": "rollback"
  },
  "official_sources": [
    "https://docs.aws.amazon.com/AmazonECR/latest/userguide/docker-push-multi-architecture-image.html",
    "https://docs.aws.amazon.com/AmazonECR/latest/userguide/image-scanning.html",
    "https://docs.github.com/en/actions/how-tos/secure-your-work/security-harden-deployments/oidc-in-aws",
    "https://github.com/docker/build-push-action"
  ]
}
