# direnv standard library: https://direnv.net/man/direnv-stdlib.1.html
dotenv_if_exists .env

export MYSTACK_CONFIG_FILE="${MYSTACK_CONFIG_FILE:-config/mystack.yaml}"
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
PATH_add "$UV_PROJECT_ENVIRONMENT/bin"

watch_file pyproject.toml
watch_file uv.lock
watch_file "$MYSTACK_CONFIG_FILE"

if ! command -v uv >/dev/null 2>&1; then
  log_error "uv is required: https://docs.astral.sh/uv/getting-started/installation/"
fi

